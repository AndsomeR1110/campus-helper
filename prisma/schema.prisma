// Prisma schema — Database Foundation
// Owner: Member 2 (Auth & Office Hours)
// Branch: feat/database-foundation
//
// Conventions (CONTRIBUTING.md §7):
//   - All timestamps are UTC (DateTime @db.Timestamptz(3)); display converts to Asia/Shanghai
//   - Enum values stay in sync with src/components/ui/status-badge.tsx STATUS_MAP
//     (status changes go through action endpoints, never PATCH { status })
//   - Business objects are never physically deleted; use a status field (CANCELLED, …)
//   - Seed data uses fictional names / IDs / emails only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

/// Slot lifecycle: teacher opens a slot; it becomes BOOKED while a confirmed
/// booking exists (derived, not stored) and CANCELLED when the teacher withdraws it.
enum SlotStatus {
  OPEN
  CANCELLED
}

/// Matches STATUS_MAP.booking. EXPIRED is set by the background job in the
/// notification service (Member 4) after the slot has passed.
enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

// ---------------------------------------------------------------- core

/// All roles share one table, distinguished by `role`.
/// Teachers have an extra TeacherProfile row; admins are only marked by role.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// bcrypt hash — never returned to the client
  passwordHash String
  name         String
  role         Role    @default(STUDENT)
  /// Student / staff number (fictional in seed data)
  studentNo    String? @unique
  isActive     Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  teacherProfile TeacherProfile?
  officeBookings OfficeBooking[]
  spaceBookings  SpaceBooking[]

  lostFoundPosts   LostFoundPost[]  @relation("LostFoundAuthor")
  lostFoundClaims  LostFoundClaim[] @relation("LostFoundClaimant")
  reportsFiled     Report[]         @relation("ReportReporter")
  reportsHandled   Report[]         @relation("ReportHandler")
  moderationAudits AuditLog[]       @relation("AuditActor")

  @@index([role])
}

// ---------------------------------------------------------- office hours

model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  department  String
  office      String?
  /// Teacher search keywords (department, course names…), lowercase
  keywords    String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  slots OfficeSlot[]

  @@index([department])
}

model OfficeSlot {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  status   SlotStatus @default(OPEN)
  location String?
  note     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bookings OfficeBooking[]

  /// "A teacher cannot hold two OPEN slots at the same start time" is enforced by a
  /// **partial** unique index (`WHERE status = 'OPEN'`) in
  /// prisma/migrations/…_partial_unique_open_slot. Deliberately not `@@unique` here:
  /// a plain unique would also block re-creating a slot at a time the teacher had
  /// previously withdrawn, because the cancelled row still occupies (teacherId, startsAt).
  @@index([startsAt, status])
}

model OfficeBooking {
  id String @id @default(cuid())

  slotId String
  slot   OfficeSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status BookingStatus @default(CONFIRMED)
  reason String?

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  /// "One CONFIRMED booking per slot" (OH-AC-03, and the same student
  /// double-submitting) is a partial unique index in
  /// prisma/migrations/…_add_active_booking_unique — Prisma cannot express
  /// partial indexes, so it lives in hand-written SQL. Do not add a unique key
  /// that includes `status`: a student must be able to cancel the same slot
  /// more than once (book → cancel → rebook → cancel).
  @@index([studentId, status])
  @@index([slotId, status])
}

// ---------------------------------------------------------------- other modules
// Added by the owning member, reviewed by Member 2:
//   M3: Space / SpaceBooking (overlapping ranges need tstzrange, not unique indexes)
//   M4: Course / CourseOccurrence / ReminderRule / Notification (dedupeKey @unique)
//   M5: LostFoundPost / LostFoundClaim / Report / AuditLog (claim.message is private)

// Member 3 owns these entities; schema/migration review by Member 2.
enum SeatType {
  QUIET
  DISCUSSION
  COMPUTER
}

model Space {
  id         String         @id
  campus     String
  building   String
  floor      Int
  seat       String
  type       SeatType
  discussion Boolean
  capacity   Int
  power      Boolean
  bookings   SpaceBooking[]

  @@index([building, floor, type])
}

model SpaceBooking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  spaceId     String
  space       Space         @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  startsAt    DateTime      @db.Timestamptz(3)
  endsAt      DateTime      @db.Timestamptz(3)
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  cancelledAt DateTime?     @db.Timestamptz(3)

  // Partial GiST exclusion constraints live in the migration (seat AND student).
  @@index([userId, status])
  @@index([spaceId, startsAt, endsAt])
}

// ------------------------------------------------------- lost & found (M5)
// Reviewed by Member 2 before merge (issue #31, part 2).
// `claim.message` is private: only the post author and administrators read it,
// which the service enforces and the queries never widen.

/// LOST = "I lost this", FOUND = "I picked this up".
enum PostKind {
  LOST
  FOUND
}

/// Matches STATUS_MAP.post in src/components/ui/status-badge.tsx.
enum PostStatus {
  OPEN
  CLAIM_PENDING
  RESOLVED
  CLOSED
  HIDDEN
}

enum PostCategory {
  ELECTRONICS
  CAMPUS_CARD
  KEYS
  BOOKS
  CLOTHING
  OTHER
}

/// Matches STATUS_MAP.claim.
enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Matches STATUS_MAP.report.
enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model LostFoundPost {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("LostFoundAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  kind        PostKind
  category    PostCategory
  title       String
  /// Public text: the form warns against ID numbers and phone numbers.
  description String
  location    String
  /// When the item was lost or found (never in the future; checked by the service).
  occurredAt  DateTime     @db.Timestamptz(3)

  status PostStatus @default(OPEN)

  /// Uploaded photo metadata. `imageUrl` stays null until storage lands; the
  /// column exists so adding it does not need a second migration.
  imageName String?
  imageType String?
  imageSize Int?
  imageUrl  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  claims  LostFoundClaim[]
  reports Report[]

  /// Browse: newest first, filtered by status.
  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([kind, category, status])
  @@index([occurredAt])
}

model LostFoundClaim {
  id     String        @id @default(cuid())
  postId String
  post   LostFoundPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  claimantId String
  claimant   User   @relation("LostFoundClaimant", fields: [claimantId], references: [id], onDelete: Cascade)

  /// Private proof of ownership; never selected outside the author/admin path.
  message String

  status    ClaimStatus @default(PENDING)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  decidedAt DateTime?   @db.Timestamptz(3)

  /// "One PENDING claim per (post, claimant)" and "at most one APPROVED claim per
  /// post" are partial unique indexes in the migration — Prisma cannot express them.
  @@index([postId, status])
  @@index([claimantId, status])
}

model Report {
  id     String        @id @default(cuid())
  postId String
  post   LostFoundPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reason String

  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime?    @db.Timestamptz(3)

  handledById String?
  handledBy   User?   @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  /// "One PENDING report per (post, reporter)": partial unique index in the migration.
  @@index([status, createdAt])
  @@index([postId])
}

/// Administrator actions on lost & found content (PRD 7.6 audit trail).
model AuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// REPORT_RESOLVED_POST_HIDDEN / REPORT_DISMISSED / POST_RESTORED …
  action     String
  targetType String
  targetId   String
  note       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([targetType, targetId])
}
