# Copy to .env.local and fill in real values. Never commit .env.local.
# When you add a variable, document it here (name + purpose only, no secrets).

# Public base URL of the app (used for absolute links, e.g. in notifications).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string — set up in feat/database-foundation (Member 2).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/campus_helper

# Session signing secret — set up in feat/auth-and-roles (Member 2).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Web Push (task #30). Generate once with: npx web-push generate-vapid-keys
# Public key is also read by the browser, so it must be NEXT_PUBLIC_*.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only. Never expose this one.
VAPID_PRIVATE_KEY=
# mailto: or https URL that identifies the sender.
VAPID_SUBJECT=mailto:support@example.com
